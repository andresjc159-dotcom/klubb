# Base de datos
DATABASE_URL="postgresql://usuario:contraseña@host:5432/klubb?schema=public"

# Secretos JWT (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="cambiar-por-secreto-aleatorio"
CLIENT_JWT_SECRET="cambiar-por-secreto-aleatorio"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3000
